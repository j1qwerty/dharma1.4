# Copy to .env.local and fill from Firebase Console → Project Settings → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=dharmatribe-cms
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics measurement ID (Firebase Console → Project Settings → Web app → SDK setup)
VITE_FIREBASE_MEASUREMENT_ID=
