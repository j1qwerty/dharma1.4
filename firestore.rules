rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isPublished() {
      return resource.data.status == 'published';
    }

    // CMS content: public can read published docs, admins can write all.
    // Covers: pujas, festivals, homepage_sections, stories, acharyas,
    // testimonials, site_settings. Drafts stay invisible until published,
    // and startDate/endDate visibility is enforced client-side via
    // src/lib/schedule.js (rules guarantee draft-privacy, client handles windows).
    // NOTE: isAdmin() comes FIRST — rules short-circuit, so admin reads of
    // not-yet-existing docs (e.g. the "does this id exist?" check on create)
    // succeed instead of erroring on resource.data (null for missing docs).
    match /pujas/{id} { allow read: if isAdmin() || isPublished(); allow write: if isAdmin(); }
    match /pujas/{id}/history/{hid} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /festivals/{id} { allow read: if isAdmin() || isPublished(); allow write: if isAdmin(); }
    match /festivals/{id}/history/{hid} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /homepage_sections/{id} { allow read: if true; allow write: if isAdmin(); }
    match /homepage_sections/{id}/history/{hid} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /stories/{id} { allow read: if isAdmin() || isPublished(); allow write: if isAdmin(); }
    match /stories/{id}/history/{hid} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /acharyas/{id} { allow read: if isAdmin() || isPublished(); allow write: if isAdmin(); }
    match /acharyas/{id}/history/{hid} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /testimonials/{id} { allow read: if isAdmin() || isPublished(); allow write: if isAdmin(); }
    match /testimonials/{id}/history/{hid} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /inquiries/{id} { allow read: if isAdmin(); allow create: if true; allow update, delete: if isAdmin(); }
    match /site_settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Users own their doc; admins can read all.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();

      // Saved delivery addresses (users/{uid}/addresses/*) — new since the
      // addresses feature landed. Owner manages own; admins can read/write
      // (bookings drawer + support). Parent match does NOT cover subcollections.
      match /addresses/{addrId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // Bookings v1: read-only in CMS. Anyone can create (guest checkout logs
    // even before sign-in); only owner/admin can read, only admin can mutate.
    match /bookings/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
